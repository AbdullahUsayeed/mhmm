{
  "expo": {
    "name": "MyWorld",
    "slug": "myworld-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myworld",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myworld.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.myworld.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF69B4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MyWorld to access your photos to add them to your globe.",
          "cameraPermission": "Allow MyWorld to use your camera to capture moments for your globe."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.myworld.app"
        }
      ]
    ]
  }
}
